<?xml version="1.0" encoding="utf-8"?>
<!--
    Значок: светлая клавиша с жирной «M» цвета фона.
    Клавиша 60×56 из 108, буква 36×28 — внутри безопасной зоны 66×66,
    поэтому её не срезает ни круг, ни квадрат, ни «капля» на рабочем столе.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Клавиша: скруглённый прямоугольник r=14 -->
    <path
        android:fillColor="#F6F0FA"
        android:pathData="M38,26 H70 A14,14 0 0 1 84,40 V68 A14,14 0 0 1 70,82 H38 A14,14 0 0 1 24,68 V40 A14,14 0 0 1 38,26 Z" />

    <!--
        Буква M — один замкнутый контур: две стойки, две диагонали и вырез
        сверху. Один контур, а не четыре полосы, иначе в монохромной версии
        на стыках вырез заливался бы обратно.
    -->
    <path
        android:fillColor="#6750A4"
        android:pathData="M36,68 L36,40 L44,40 L54,62 L64,40 L72,40 L72,68 Z" />
</vector>
