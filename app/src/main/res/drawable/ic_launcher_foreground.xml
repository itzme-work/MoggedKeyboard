<?xml version="1.0" encoding="utf-8"?>
<!--
    Значок: светлая клавиша с жирной «M» цвета фона.
    Клавиша 60×56 из 108, буква 40×32 по центру клавиши (54,54) —
    внутри безопасной зоны 66×66, поэтому её не срезает ни круг,
    ни квадрат, ни «капля» на рабочем столе.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Клавиша: скруглённый прямоугольник r=14 -->
    <path
        android:fillColor="#F6F0FA"
        android:pathData="M38,26 H70 A14,14 0 0 1 84,40 V68 A14,14 0 0 1 70,82 H38 A14,14 0 0 1 24,68 V40 A14,14 0 0 1 38,26 Z" />

    <!--
        Буква M — один замкнутый контур: две стойки, две диагонали
        и вырезы снизу. Нижние вырезы обязательны, иначе получается
        прямоугольник с вырезом сверху и читается как «V».
    -->
    <path
        android:fillColor="#6750A4"
        android:pathData="M34,70 V38 H42 L54,54 L66,38 H74 V70 H66 V50 L54,64 L42,50 V70 Z" />
</vector>
